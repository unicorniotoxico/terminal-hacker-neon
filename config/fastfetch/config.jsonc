{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "__LOGO_PATH__",
    "color": {
      "1": "cyan",
      "2": "blue",
      "3": "magenta",
      "4": "green",
      "5": "yellow",
      "6": "red"
    }
  },

  "display": {
    "separator": " 󰄾 "
  },

  "modules": [
    {
      "type": "title",
      "color": "cyan"
    },
    {
      "type": "separator",
      "color": "blue"
    },
    {
      "type": "os",
      "keyColor": "magenta"
    },
    {
      "type": "host",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "keyColor": "magenta"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}